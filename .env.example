# Create a key at https://aistudio.google.com/apikey and never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_CHAT_TIMEOUT_SECONDS=20
GEMINI_FALLBACK_TO_LOCAL=true
# Set local for an offline synthetic demo.
RAG_MODE=gemini
CHROMA_PATH=chroma_data
REPORTS_PATH=reports
TOP_K=4
MAX_ATTACK_BUDGET_TOKENS=500
